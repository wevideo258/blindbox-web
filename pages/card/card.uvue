<template>
	<view class="page-wrapper">
		<scroll-view class="container" scroll-y="true">
			<!-- 1. 核心图片区与四大系列热区 -->
			<view class="card-page-content">
				<!-- 整张集卡背景图 -->
				<image class="full-bg-img" src="/static/集卡.png" mode="widthFix"></image>

				<!-- 四大入口点击热区 -->
				<view class="hotspots-grid">
					<!-- 招财 (左上) -->
					<view class="hotspot-item" @click="navigateToSeries('zhaocai', '招财', '/pages/card/zhaocai')"></view>

					<!-- 辟邪 (右上) -->
					<view class="hotspot-item" @click="navigateToSeries('pixie', '辟邪', '/pages/card/pixie')"></view>

					<!-- 改运 (左下) -->
					<view class="hotspot-item" @click="navigateToSeries('gaiyun', '改运', '/pages/card/gaiyun')"></view>

					<!-- 神兽 (右下) -->
					<view class="hotspot-item" @click="navigateToSeries('shenshou', '神兽', '/pages/card/shenshou')"></view>
				</view>

				<!-- 顶部返回/搜索按钮热区 -->
				<view class="top-nav-hotspots">
					<view class="top-back-btn" @click="goBack"></view>
					<view class="top-search-btn" @click="onSearch"></view>
				</view>
			</view>

			<!-- 2. 底部拓展区域：🏆 我的集卡进度（卡册完成度） -->
			<view class="bottom-extension-section">

				<!-- 集卡成就与进度卡片 -->
				<view class="achievement-card">
					<view class="achieve-header">
						<view class="achieve-title-box">
							<text class="achieve-icon">🏆</text>
							<text class="achieve-title">我的集卡进度</text>
						</view>
						<!-- 显示当前收集进度，总数为 51 张 -->
						<text class="achieve-count">12 / 51 <text class="unit">张</text></text>
					</view>

					<!-- 进度条（12/51 约为 23.5%） -->
					<view class="progress-bar-bg">
						<view class="progress-bar-fill" style="width: 23.5%;"></view>
					</view>

					<view class="achieve-footer">
						<text class="achieve-tips">已收集 23.5% · 集齐套卡可解锁限定盲盒</text>

						<!-- 快捷入口按钮 -->
						<view class="shortcut-actions">
							<view class="reward-btn" @click="onOpenBook">
								<text class="reward-btn-text">📖 卡册图鉴</text>
							</view>
							<view class="reward-btn gold-btn" @click="onOpenRewards">
								<text class="reward-btn-text gold-text">🎁 成就奖励</text>
							</view>
						</view>
					</view>
				</view>

			</view>

			<!-- 底部安全垫高区，防止内容被底部 TabBar 遮挡 -->
			<view class="bottom-safe-space"></view>
		</scroll-view>

		<!-- 3. 底部导航栏组件 -->
		<NeonTabBar :current="3" />
	</view>
</template>

<script>
import NeonTabBar from '@/components/NeonTabBar.uvue';

export default {
	components: {
		NeonTabBar
	},
	data() {
		return {};
	},
	methods: {
		goBack() {
			uni.navigateBack({
				fail() {
					uni.switchTab({ url: '/pages/index/index' });
				}
			});
		},
		onSearch() {
			uni.showToast({ title: '搜索图鉴中...', icon: 'none' });
		},
		navigateToSeries(id, title, targetUrl) {
			uni.navigateTo({
				url: targetUrl,
				fail() {
					uni.showToast({ title: `正在进入【${title}】集卡页面`, icon: 'none' });
				}
			});
		},
		onOpenBook() {
			uni.showToast({ title: '打开卡册图鉴中...', icon: 'none' });
		},
		onOpenRewards() {
			uni.showToast({ title: '打开成就奖励页...', icon: 'none' });
		}
	}
};
</script>

